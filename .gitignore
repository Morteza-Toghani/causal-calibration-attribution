cat > .gitignore << 'EOF'
# Python
__pycache__/
*.pyc
*.pyo
.venv/
venv/
env/
*.egg-info/

# Jupyter
.ipynb_checkpoints/

# Data (large files, keep only manifests)
data/*
!data/manifests/
!data/.gitkeep

# Results (generated outputs)
results/figures/*
results/tables/*
results/logs/*
!results/figures/.gitkeep
!results/tables/.gitkeep
!results/logs/.gitkeep

# OS files
.DS_Store
Thumbs.db

# IDE
.vscode/
.idea/
EOF
